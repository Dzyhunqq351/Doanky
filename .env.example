PORT=3000
# Gmail: use an App Password from a Google account with 2-Step Verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Local: mongodb://127.0.0.1:27017/playroom
# Atlas: mongodb+srv://<database-user>:<url-encoded-password>@<cluster>/playroom?retryWrites=true&w=majority&appName=<app>
MONGODB_URI=mongodb://127.0.0.1:27017/playroom
MONGODB_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
# Chạy npm run auth:setup để tạo JWT_SECRET trong .env, không commit khóa thật.
JWT_SECRET=
# Khi dùng reverse proxy HTTPS hoặc Vite HMR, đặt đúng origin trình duyệt:
# APP_ORIGIN=https://playroom.example.com
# Chỉ bật production khi phục vụ qua HTTPS (cookie Secure):
# NODE_ENV=production
