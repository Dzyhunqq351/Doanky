{
    "services": {
        "web": {
            "root": "client/",
            "framework": "vite",
            "rewrites": [
                {
                    "source": "/(.*)",
                    "destination": "/index.html"
                }
            ]
        },
        "server": {
            "root": ".",
            "framework": "node",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/socket.io/(.*)",
            "destination": {
                "service": "server"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "web"
            }
        }
    ]
}