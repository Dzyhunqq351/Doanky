{
  "name": "playroom",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "auth:setup": "node scripts/setup-auth.js",
    "dev": "npm run build && concurrently -k -n server,client \"nodemon server.js\" \"npm run build:watch --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run typecheck --workspace client",
    "format": "prettier --write server.js src shared client/src tests",
    "test:db": "node --test tests/auth-http.test.js",
    "db:migrate:atlas": "node scripts/migrate-atlas.js",
    "db:audit": "node scripts/audit-database.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "mongoose": "^8.13.0",
    "nodemailer": "^10.0.14",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "prettier": "^3.6.2"
  }
}
